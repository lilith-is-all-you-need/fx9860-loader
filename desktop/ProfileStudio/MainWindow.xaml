<Window x:Class="ProfileStudio.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:ProfileStudio" Title="FX Profile Studio">
 <Grid x:Name="RootPanel" Background="#F5F6F8" RequestedTheme="Light" Loaded="OnLoaded"
       SizeChanged="LayoutChanged" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Grid.Resources>
   <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
   <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#596579"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
   <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="BorderBrush" Value="#E3E7ED"/><Setter Property="BorderThickness" Value="1"/></Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="#132A3A" Padding="22,28,18,24">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="16">
     <Border Background="#C4F1DD" Width="46" Height="46" CornerRadius="12" HorizontalAlignment="Left"><TextBlock Text="FX" FontWeight="Bold" FontSize="21" Foreground="#132A3A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="Profile Studio" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
     <TextBlock Text="fx-9860GIII" FontSize="13" Foreground="#B8C7D1"/>
     <Border Background="#294453" CornerRadius="8" Padding="13,12" Margin="0,16,0,0"><TextBlock x:Name="SidebarStep" Foreground="White" TextWrapping="Wrap"/></Border>
    </StackPanel>
    <StackPanel Grid.Row="2" Spacing="10">
     <TextBlock x:Name="OfflineTitle" Foreground="#C4F1DD" FontWeight="SemiBold"/>
     <TextBlock x:Name="OfflineBody" Foreground="#B8C7D1" FontSize="12" TextWrapping="Wrap"/>
     <TextBlock x:Name="VersionText" Foreground="#8EA4B2" FontSize="12" Margin="0,12,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="24" Spacing="18">
     <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="7"><TextBlock x:Name="PageTitle" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="PageSubtitle" Style="{StaticResource Muted}"/></StackPanel>
      <ComboBox x:Name="LanguageBox" Grid.Column="1" VerticalAlignment="Top" SelectionChanged="LanguageChanged" MinWidth="118" AutomationProperties.Name="Language">
       <ComboBoxItem Content="中文"/><ComboBoxItem Content="English"/>
      </ComboBox>
     </Grid>
     <InfoBar x:Name="CompatibilityNote" IsOpen="True" IsClosable="False" Severity="Informational"/>
     <Grid x:Name="WorkspaceGrid" ColumnSpacing="18" RowSpacing="18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="320"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="16">
       <Border Style="{StaticResource Card}">
        <StackPanel Spacing="14">
         <Grid><TextBlock x:Name="QueueTitle" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button x:Name="ClearButton" Click="ClearClick"/><Button x:Name="AddButton" Click="AddClick"/></StackPanel></Grid>
         <TextBlock x:Name="QueueHint" Style="{StaticResource Muted}" FontSize="12"/>
         <ListView x:Name="QueueList" ItemsSource="{x:Bind Items}" SelectionChanged="SelectionChanged" Height="200" SelectionMode="Single">
          <ListView.ItemTemplate><DataTemplate x:DataType="local:QueueItem"><Grid Padding="2,10" ColumnSpacing="12">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="146"/></Grid.ColumnDefinitions>
           <StackPanel Spacing="4"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Size, Mode=OneWay}" FontSize="12" Foreground="#687486"/></StackPanel>
           <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Status, Mode=OneWay}" Foreground="{x:Bind StatusColor, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Backend, Mode=OneWay}" FontSize="11" Foreground="#687486" TextWrapping="Wrap"/></StackPanel>
          </Grid></DataTemplate></ListView.ItemTemplate>
         </ListView>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}">
        <StackPanel Spacing="12"><TextBlock x:Name="OutputTitle" Style="{StaticResource SectionTitle}"/>
         <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputBox"/><Button x:Name="BrowseButton" Grid.Column="1" Click="OutputBrowse"/></Grid>
         <TextBlock x:Name="OutputHint" FontSize="12" Style="{StaticResource Muted}"/>
         <CheckBox x:Name="IncludeLoaderBox"/>
         <TextBlock x:Name="LoaderHint" FontSize="12" Style="{StaticResource Muted}"/>
        </StackPanel>
       </Border>
       <Expander x:Name="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="12">
         <ToggleSwitch x:Name="DeepSwitch"/>
         <TextBlock x:Name="DeepHint" Style="{StaticResource Muted}" FontSize="12"/>
         <TextBox x:Name="GhidraBox"/>
         <TextBox x:Name="JavaBox"/>
         <Button x:Name="DependenciesButton" Click="CheckDependencies"/><TextBlock x:Name="DependencyText" TextWrapping="Wrap" FontSize="12" Foreground="#596579"/>
        </StackPanel>
       </Expander>
      </StackPanel>
      <StackPanel x:Name="DetailsPanel" Grid.Column="1" Spacing="16">
       <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
        <TextBlock x:Name="DetailTitle" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="DetailName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="DetailSize" Style="{StaticResource Muted}"/>
        <ProgressBar x:Name="PageBar" Maximum="768" Value="0" Foreground="#218467"/>
        <TextBlock x:Name="PageHint" Style="{StaticResource Muted}" FontSize="12"/>
        <Border Height="1" Background="#E3E7ED" Margin="0,4"/>
        <TextBlock x:Name="DetailStatus" FontWeight="SemiBold" Foreground="#166A55" TextWrapping="Wrap"/>
        <TextBlock x:Name="DetailBody" TextWrapping="Wrap" FontSize="13" IsTextSelectionEnabled="True"/>
        <TextBlock x:Name="DetailAnalysis" Style="{StaticResource Muted}" FontSize="13" IsTextSelectionEnabled="True" Visibility="Collapsed"/>
        <TextBlock x:Name="DetailPath" TextWrapping="Wrap" FontSize="11" Foreground="#687486" IsTextSelectionEnabled="True"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
         <Button x:Name="OpenButton" IsEnabled="False" Click="OpenResult"/>
         <Button x:Name="ReportButton" IsEnabled="False" Click="OpenReport"/>
        </StackPanel>
        <Expander x:Name="Diagnostics" HorizontalAlignment="Stretch"><TextBox x:Name="RawDetail" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="240" FontSize="11"/></Expander>
       </StackPanel></Border>
       <Border Background="#E8F3EF" CornerRadius="12" Padding="20"><StackPanel Spacing="10">
        <TextBlock x:Name="ResultsTitle" FontWeight="SemiBold" Foreground="#1B5E49"/>
        <TextBlock x:Name="ResultsBody" FontSize="12" Foreground="#35594D" LineHeight="23" TextWrapping="Wrap"/>
        <TextBlock x:Name="ResultsHint" FontSize="12" Foreground="#35594D" TextWrapping="Wrap"/>
       </StackPanel></Border>
      </StackPanel>
     </Grid>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="1" Background="White" BorderBrush="#E3E7ED" BorderThickness="0,1,0,0" Padding="24,16">
    <StackPanel Spacing="12">
     <TextBlock x:Name="ProgressText" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" FontSize="13"/>
     <ProgressBar x:Name="Progress" IsIndeterminate="False" Value="0" Height="3"/>
     <Grid>
      <Button x:Name="ExportButton" Click="ExportClick"/>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
       <Button x:Name="OpenExportButton" IsEnabled="False" Click="OpenExport"/>
       <Button x:Name="CancelButton" IsEnabled="False" Click="CancelClick"/>
       <Button x:Name="GenerateButton" Style="{StaticResource AccentButtonStyle}" Click="GenerateClick"/>
      </StackPanel>
     </Grid>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
